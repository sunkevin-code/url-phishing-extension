{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "notifications",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://safebrowsing.googleapis.com/"
  ],
  "background": {
    "service_worker": "lib/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/rules.js",
        "lib/ml_inference.js",
        "lib/ml_weights.json",
        "lib/rf_inference.js",
        "lib/rf_weights.json",
        "lib/keylogger-detector.js",
        "test-standalone.html",
        "dashboard.html",
        "dashboard.js",
        "blocked.html",
        "test-fetcher.js",
        "corpus-samples.js",
        "test-runner.html",
        "test-runner.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
